DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
REDIS_URL="rediss://default:password@host:6379"

PORT=3000
NODE_ENV=development

CORS_ORIGINS=*
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=100
SHUTDOWN_TIMEOUT_MS=10000

JWT_ACCESS_SECRET="super-secret-access-key-change-in-production"
JWT_REFRESH_SECRET="super-secret-refresh-key-change-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Scraping env vars
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx  # Optional: lifts GitHub REST from 60/hr to 5000/hr
# ENABLE_LINKEDIN_SCRAPER=false  # Enable LinkedIn scraping (disabled by default)
# SCOUT_PROXY=http://user:pass@host:port  # HTTP proxy for scrapers
# SCOUT_PROXY_FILE=/path/to/proxies.txt  # File with proxy list
# SCOUT_FREE_PROXY=true  # Use free proxy rotation (best-effort)
# SCOUT_DELAY_MIN=500  # Minimum delay between requests (ms)
# SCOUT_DELAY_MAX=4000  # Maximum delay between requests (ms)
